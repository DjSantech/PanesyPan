# URL base de la API (sin barra final). Vacía: la web usa datos de ejemplo.
# Producción: https://api.panesypan.com (pasa por Cloudflare, que agrega X-Origin-Verify).
# También define img-src y connect-src de la CSP en next.config.ts.
NEXT_PUBLIC_API_URL=

# URL pública de la web (sin barra final) para canonical, sitemap y Open Graph.
# Producción: https://panesypan.com
NEXT_PUBLIC_SITE_URL=
