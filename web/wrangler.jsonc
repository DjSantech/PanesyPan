{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Web pública (panesypan.com) como Cloudflare Worker con OpenNext.
  // El nombre debe coincidir con el del Worker en el panel y con WORKER_SELF_REFERENCE.
  "name": "panes-y-pan-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-30",
  // global_fetch_strictly_public: las llamadas a api.panesypan.com (misma zona) salen por
  // internet y pasan por la regla de Cloudflare que agrega la cabecera X-Origin-Verify.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "panes-y-pan-web" }],
  // Caché de las páginas en Workers KV (plan gratis, sin tarjeta: si se llega al límite diario
  // no se cobra, solo dejan de guardarse páginas nuevas ese día). Sin esto, el menú del día se
  // quedaría con lo que había al compilar. Sin "id": wrangler crea el espacio al desplegar.
  "kv_namespaces": [{ "binding": "NEXT_INC_CACHE_KV" }],
  // URLs públicas (no son secretos). Van aquí y no en el panel: `wrangler deploy` borra las
  // variables del panel que no estén en este archivo.
  "vars": {
    "NEXT_PUBLIC_API_URL": "https://api.panesypan.com",
    "NEXT_PUBLIC_SITE_URL": "https://panesypan.com",
  },
  "observability": { "enabled": true },
}
