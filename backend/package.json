{
  "name": "@panesypan/backend",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "API REST de Panes & Pan (Express + MongoDB).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "seed:admin": "tsx --env-file-if-exists=.env scripts/seed-admin.ts",
    "seed:catalog": "tsx --env-file-if-exists=.env scripts/seed-catalog.ts",
    "reset:password": "tsx --env-file-if-exists=.env scripts/reset-password.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "images:to-cloudinary": "tsx --env-file-if-exists=.env scripts/migrate-images-cloudinary.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@panesypan/shared": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "mongoose": "^9.10.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "socket.io": "^4.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.6",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.1.3",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  }
}
