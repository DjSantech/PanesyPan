# ─────────────────────────────────────────────────────────────
# API de PanesYPan · copia este archivo como .env y ajusta los valores.
# El archivo .env NUNCA se sube al repositorio.
# ─────────────────────────────────────────────────────────────

# development | test | production
NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Local: MongoDB de desarrollo que levanta "pnpm dev:db" (replica set, soporta transacciones).
# Producción: cadena de conexión de MongoDB Atlas (mongodb+srv://USUARIO:CLAVE@CLUSTER/...).
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB_NAME=panesypan_dev

# Orígenes que pueden llamar a la API desde el navegador, separados por coma.
# Producción: https://sistema.panesypan.com
CORS_ORIGINS=http://localhost:5173

# Proxies de confianza delante de la API (0 en local, 1 en Render).
TRUST_PROXY_HOPS=0

# Secreto que Cloudflare agrega en el header X-Origin-Verify (obligatorio en producción).
# Genera uno con: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
ORIGIN_VERIFY_SECRET=

# Límite general de peticiones por IP (ventana en milisegundos).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
