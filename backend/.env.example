# ─────────────────────────────────────────────────────────────
# API de Panes & Panes · copia este archivo como .env y ajusta los valores.
# El archivo .env NUNCA se sube al repositorio.
# ─────────────────────────────────────────────────────────────

# development | test | production
NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Local: MongoDB de desarrollo que levanta "pnpm dev:db" (replica set, soporta transacciones).
# Producción: cadena de conexión de MongoDB Atlas (mongodb+srv://USUARIO:CLAVE@CLUSTER/...).
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB_NAME=panesypan_dev

# Orígenes que pueden llamar a la API desde el navegador, separados por coma.
# Producción: https://sistema.panesypan.com,https://panesypan.com,https://www.panesypan.com
# (panel POS + web pública apex y www; sin barra final)
CORS_ORIGINS=http://localhost:5173

# Proxies de confianza delante de la API (0 en local, 1 en Render).
TRUST_PROXY_HOPS=0

# Secreto que Cloudflare agrega en el header X-Origin-Verify (obligatorio en producción).
# Genera uno con: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
ORIGIN_VERIFY_SECRET=

# Límite general de peticiones por IP (ventana en milisegundos).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
# Intentos fallidos de login/PIN por IP cada 15 minutos (todo el local comparte una IP).
AUTH_RATE_LIMIT_MAX=30

# Secretos de sesión (obligatorios): cadenas aleatorias de al menos 32 caracteres,
# DISTINTAS entre sí y distintas en cada ambiente. Genera cada una con:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_ACCESS_SECRET=
CSRF_SECRET=

# Facturación electrónica con Factus (https://www.factus.com.co). Déjalas vacías para usar
# solo el proveedor simulado. sandbox = pruebas de habilitación · production = facturas reales.
# Las credenciales las entrega Factus (panel → API). Nunca las subas al repositorio.
FACTUS_ENV=sandbox
FACTUS_CLIENT_ID=
FACTUS_CLIENT_SECRET=
FACTUS_USERNAME=
FACTUS_PASSWORD=

# Primer administrador: se crea al arrancar solo si todavía no existe ninguno.
# Deberá cambiar la contraseña en su primer ingreso. Después de crearlo, borra SEED_ADMIN_PASSWORD.
SEED_ADMIN_NAME=
SEED_ADMIN_USERNAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
